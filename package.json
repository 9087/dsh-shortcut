{
  "name": "dsh-shortcut",
  "version": "0.4.1",
  "description": "DeepSeek Harness plugin: saved shortcuts (name + target agent + text) with a workspace/session/agent tree picker, a sidebar menu that delivers a shortcut's text to its target without switching sessions, and per-message capture from user bubbles",
  "packageManager": "pnpm@11.22.0",
  "author": "Wu Zhiwei",
  "license": "MIT",
  "homepage": "https://github.com/9087/dsh-shortcut#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9087/dsh-shortcut.git"
  },
  "bugs": {
    "url": "https://github.com/9087/dsh-shortcut/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "shortcut",
    "prompt",
    "sessions",
    "subagents"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json",
    "build": "tsc -b tsconfig.json && tsdown --env.DSH_BUILD_FACE client",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify:release": "node scripts/verify-release.mjs",
    "release": "release-it && node scripts/verify-release.mjs",
    "prepare": "tsc -b tsconfig.json && tsdown --env.DSH_BUILD_FACE client"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@playwright/test": "^1.63.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "release-it": "^21.1.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
